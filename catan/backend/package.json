{
  "private": true,
  "name": "backend",
  "version": "0.1.0",
  "description": "A Colyseus multiplayer server",
  "type": "module",
  "main": "build/index.js",
  "engines": {
    "node": ">= 22.0.0"
  },
  "scripts": {
    "start": "tsx watch src/index.ts",
    "loadtest": "tsx loadtest/example.ts --room my_room --numClients 2",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "clean": "rimraf build",
    "test": "mocha -r tsx test/**.test.ts --exit --timeout 15000",
    "test:spec": "mocha -r tsx test/**.test.ts --reporter spec --slow 0 --no-diff --exit --timeout 15000",
    "test:dot": "mocha -r tsx test/**.test.ts --reporter dot --no-diff --exit --timeout 15000",
    "test:watch": "mocha -r tsx test/**.test.ts --reporter dot --no-diff --watch --timeout 15000"
  },
  "author": "",
  "license": "UNLICENSED",
  "devDependencies": {
    "@colyseus/loadtest": "^0.18.1",
    "@colyseus/sdk": "^0.18.1",
    "@colyseus/testing": "^0.18.5",
    "@types/express": "^5.0.6",
    "@types/mocha": "^10.0.1",
    "mocha": "^11.7.5",
    "rimraf": "^5.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.0.4"
  },
  "dependencies": {
    "@colyseus/schema": "^5.0.27",
    "@colyseus/tools": "^0.18.3",
    "colyseus": "^0.18.5",
    "express": "^5.2.1"
  }
}
